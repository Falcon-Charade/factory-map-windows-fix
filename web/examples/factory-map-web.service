# systemd user service. Install:
#   mkdir -p ~/.config/systemd/user && cp factory-map-web.service ~/.config/systemd/user/
#   edit the paths below, then:
#   systemctl --user daemon-reload && systemctl --user enable --now factory-map-web
#   loginctl enable-linger $USER     # keep it running when you're logged out
[Unit]
Description=Factory Map website
After=network-online.target

[Service]
WorkingDirectory=%h/factory-map/web
# the venv from the README's quick start (or /usr/bin/python3 if Pillow and numpy are installed system-wide)
ExecStart=%h/factory-map/web/.venv/bin/python %h/factory-map/web/server.py
# Folder that contains the server's mods/ and script-output/ folders
Environment=FACTORIO_DATA=%h/factorio
Environment=WEB_BIND=127.0.0.1
Environment=WEB_PORT=8480
Environment=MALLOC_ARENA_MAX=2
Restart=on-failure
RestartSec=5
Nice=5

[Install]
WantedBy=default.target
